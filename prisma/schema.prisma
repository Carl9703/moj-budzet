generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  createdAt          DateTime             @default(now())
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  role               String               @default("USER")
  updatedAt          DateTime             @updatedAt
  isActive           Boolean              @default(true)
  lastLoginAt        DateTime?
  loginAttempts      Int                  @default(0)
  lockedUntil        DateTime?
  accounts           Account[]
  categories         Category[]
  envelopes          Envelope[]
  fxLots             FxLot[]
  investments        InvestmentAsset[]
  recurringPayments  RecurringPayment[]
  sessions           Session[]
  transactions       Transaction[]
  userConfig         UserConfig?
  currencyWallets    CurrencyWallet[]
  currencyTx         CurrencyTransaction[]
  pendingTransactions PendingTransaction[]
}

model Envelope {
  id                     String             @id @default(cuid())
  userId                 String
  name                   String
  type                   String
  plannedAmount          Decimal            @default(0) @db.Decimal(19, 4)
  currentAmount          Decimal            @default(0) @db.Decimal(19, 4)
  icon                   String?
  group                  String?
  isArchived             Boolean            @default(false)
  envelopeType           String             @default("budget")
  isAccumulating         Boolean            @default(false)
  // Natywna obsługa wielu walut
  currencyCode           String             @default("PLN")
  parentEnvelopeId       String?
  parentEnvelope         Envelope?          @relation("EnvelopeHierarchy", fields: [parentEnvelopeId], references: [id])
  childEnvelopes         Envelope[]         @relation("EnvelopeHierarchy")
  fxLots                 FxLot[]
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringPayments      RecurringPayment[]
  recurringFromTransfers RecurringPayment[] @relation("RecurringPaymentFrom")
  recurringToTransfers   RecurringPayment[] @relation("RecurringPaymentTo")
  transactions           Transaction[]
}

model Transaction {
  id                  String    @id @default(cuid())
  userId              String
  type                String
  amount              Decimal   @db.Decimal(19, 4)
  description         String?
  includeInStats      Boolean   @default(true)
  date                DateTime
  envelopeId          String?
  category            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  transferPairId      String?
  // Pola dla transferów międzywalutowych (cross-currency)
  sourceAmount        Decimal?  @db.Decimal(19, 4)
  sourceCurrency      String?
  destinationAmount   Decimal?  @db.Decimal(19, 4)
  destinationCurrency String?
  exchangeRate        Decimal?  @db.Decimal(19, 6)
  // Koszt historyczny w PLN wyliczony przez FIFO (tylko dla wydatków walutowych)
  plnEquivalent       Decimal?  @db.Decimal(19, 4)
  envelope            Envelope? @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fxLotConsumptions   FxLotConsumption[]
  generatedFxLots     FxLot[]   @relation("FxLotSourceTx")

  @@index([userId, date])
  @@index([envelopeId])
  @@index([transferPairId])
}

// Lot waluty obcej — jednostka kosztu nabycia dla algorytmu FIFO
model FxLot {
  id                  String   @id @default(cuid())
  userId              String
  envelopeId          String
  date                DateTime
  // Ile waluty obcej zakupiono w tym locie (np. 300 EUR)
  originalAmount      Decimal  @db.Decimal(19, 4)
  // Ile pozostało do skonsumowania (maleje przy każdym wydatku FIFO)
  remainingAmount     Decimal  @db.Decimal(19, 4)
  // Ile PLN zapłacono za cały lot (np. 1290 PLN)
  costBasisPln        Decimal  @db.Decimal(19, 4)
  // Kurs nabycia: costBasisPln / originalAmount (np. 4.300000)
  exchangeRate        Decimal  @db.Decimal(19, 6)
  // Waluta obca lotu (np. EUR, USD, GBP)
  foreignCurrency     String   @default("EUR")
  // Referencja do transferu, który wygenerował ten lot
  sourceTransactionId String?
  sourceTransaction   Transaction? @relation("FxLotSourceTx", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  envelope            Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fxLotConsumptions   FxLotConsumption[]

  @@index([envelopeId, date])
  @@index([userId])
}

// Tabela śledząca konsumpcję lotów (do cofania transakcji walutowych)
model FxLotConsumption {
  id              String      @id @default(cuid())
  transactionId   String
  fxLotId         String
  amountConsumed  Decimal     @db.Decimal(19, 4)
  createdAt       DateTime    @default(now())
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fxLot           FxLot       @relation(fields: [fxLotId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([fxLotId])
}

model UserConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  defaultSalary     Decimal  @default(0) @db.Decimal(19, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  bonusDistribution String?
  apiToken          String?  @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringPayment {
  id             String    @id @default(cuid())
  userId         String
  name           String
  amount         Decimal   @db.Decimal(19, 4)
  dayOfMonth     Int
  envelopeId     String?
  category       String?
  isActive       Boolean   @default(true)
  dismissedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  type           String    @default("expense")
  fromEnvelopeId String?
  toEnvelopeId   String?
  envelope       Envelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  fromEnvelope   Envelope? @relation("RecurringPaymentFrom", fields: [fromEnvelopeId], references: [id], onDelete: SetNull)
  toEnvelope     Envelope? @relation("RecurringPaymentTo", fields: [toEnvelopeId], references: [id], onDelete: SetNull)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  name            String
  icon            String
  type            String
  defaultEnvelope String?
  userId          String
  isArchived      Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model InvestmentAsset {
  id                   String    @id @default(cuid())
  userId               String
  symbol               String
  quantity             Float
  averagePurchasePrice Decimal   @db.Decimal(19, 6)
  type                 AssetType
  currency             String    @default("PLN")
  totalContributed     Decimal?  @db.Decimal(19, 4)
  manualCurrentValue   Decimal?  @db.Decimal(19, 4)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("InvestmentPosition")
}

enum AssetType {
  CRYPTO
  STOCK
  PPK
}

// --- Legacy: CurrencyWallet (deprecjonowany — zastąpiony przez Envelope z currencyCode) ---
// Zachowany jako read-only backup po migracji. Usunąć po weryfikacji danych.

model CurrencyWallet {
  id           String                @id @default(cuid())
  userId       String
  name         String
  currency     String
  balance      Decimal               @default(0) @db.Decimal(19, 4)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CurrencyTransaction[]

  @@index([userId])
}

model CurrencyTransaction {
  id           String         @id @default(cuid())
  walletId     String
  userId       String
  amount       Decimal        @db.Decimal(19, 4)
  plnAmount    Decimal?       @db.Decimal(19, 4)
  exchangeRate Decimal?       @db.Decimal(19, 6)
  description  String?
  date         DateTime
  type         String
  createdAt    DateTime       @default(now())
  wallet       CurrencyWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
}

model PendingTransaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Decimal  @db.Decimal(19, 4)
  currency      String   @default("PLN")
  description   String
  date          DateTime
  source        String   @default("google_wallet")
  cardLastFour  String?
  suggestedCat  String?
  suggestedEnv  String?
  suggestedDesc String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

