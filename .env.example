# Database
# Provide the connection string to your PostgreSQL database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Development Database (Optional, used if branch is 'dev')
DATABASE_URL_DEV="postgresql://user:password@host:port/database_dev?sslmode=require"

# NextAuth
# Generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Security
# Secret for JWT signing
JWT_SECRET=""

# Optional: Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=""
